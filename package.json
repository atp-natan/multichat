{
  "name": "multichat",
  "desktopName": "multichat",
  "version": "1.7.1",
  "description": "MultiChat — Multi-account messenger desktop app",
  "author": "Maicon Fontana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maiconfontana/multichat.git"
  },
  "homepage": "https://github.com/maiconfontana/multichat#readme",
  "bugs": {
    "url": "https://github.com/maiconfontana/multichat/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/maiconfontana"
  },
  "keywords": [
    "multichat",
    "electron",
    "multi-account",
    "whatsapp",
    "messenger",
    "desktop-app"
  ],
  "main": "./src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check src/main.js && node --check src/whatsapp-preload.js && node --check src/whatsapp-assistant-adapter.js && node --check src/assistant-core.js && node --check src/assistant-settings.js && node --check src/openai-client.js && node --check src/assistant-preload.js && node --check src/assistant.js && node --check src/messenger-preload.js && node --check src/accounts.js && node --check src/preload.js && node --check src/resource-policy.js && node --check src/update-check.js && node --check src/account-avatar.js && node --check src/idle-preload.js && node --check src/apply-update.js && node --check src/deeplink.js && node --check src/unread-badge.js && node --check src/account-shortcuts.js && node --check src/release-notes.js && node --check src/whats-new.js && node --check src/whats-new-preload.js",
    "icons": "electron scripts/gen-icon.js",
    "bump": "node scripts/bump-version.js",
    "whats-new": "node scripts/gen-whats-new.js",
    "whats-new:check": "node scripts/gen-whats-new.js --check",
    "whats-new:preview": "electron . --whats-new-preview",
    "clean": "rm -rf ./dist",
    "build:local": "bash build-local.sh",
    "update:local": "bash update-local.sh",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --x64",
    "dist:windows": "electron-builder --windows --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "build": {
    "appId": "com.maiconfontana.multichat",
    "productName": "MultiChat",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "artifactName": "MultiChat-${version}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.xz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "MultiChat-${version}-win-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MultiChat-${version}-setup.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MultiChat-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "WhatsApp",
        "schemes": [
          "whatsapp"
        ]
      },
      {
        "name": "Microsoft Teams",
        "schemes": [
          "msteams",
          "ms-teams"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^42.11.1",
    "electron-builder": "^26.15.7"
  }
}
